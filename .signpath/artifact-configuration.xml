<?xml version="1.0" encoding="utf-8"?>
<!--
  SignPath artifact configuration for GabNetStats.

  This file is a versioned copy only: SignPath does not read it from the repository.
  Paste it into SignPath > Project > Artifact Configurations whenever it changes.

  The GitHub artifact uploaded by the release workflow is a zip with one folder per
  Windows architecture (x64, x86, arm64), each holding a complete build output.
  Only our own binaries are signed; Microsoft.Bcl.HashCode.dll,
  Microsoft.Windows.SDK.NET.dll and WinRT.Runtime.dll are already signed by
  Microsoft and are passed through unchanged.
-->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file-set>
      <!-- One of each per architecture folder -->
      <include path="*/GabNetStats.exe" min-matches="3" max-matches="3" />
      <include path="*/GabNetStats.dll" min-matches="3" max-matches="3" />
      <include path="*/GabTracker.dll" min-matches="3" max-matches="3" />
      <!-- Satellite resource assemblies: <architecture>/<culture>/GabNetStats.resources.dll -->
      <include path="*/*/GabNetStats.resources.dll" min-matches="3" max-matches="unbounded" />
      <for-each>
        <authenticode-sign />
      </for-each>
    </pe-file-set>
  </zip-file>
</artifact-configuration>
